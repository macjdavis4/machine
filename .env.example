# Required
ANTHROPIC_API_KEY=sk-ant-...

# Personality + UI mode: 'jarvis' or 'samaritan' (default: samaritan).
# Also persisted to ~/.samaritan/mode after every /mode switch.
SAMARITAN_MODE=samaritan

# How the assistant addresses you.
SAMARITAN_USER_NAME=Sir

# macOS `say` voice. Try Karen, Moira, Oliver, Samantha, Daniel.
SAMARITAN_VOICE=Daniel

# Auto-load the most recent saved session on startup ('1' to enable).
SAMARITAN_AUTOLOAD=0

# Skip the confirmation prompt before destructive tool calls (DANGEROUS).
# When unset (or anything other than '1'), the operator must approve each
# call to: create_apple_note, append_to_apple_note, speak, open_url,
# set_reminder, music_control, clipboard_write, forget_fact.
SAMARITAN_AUTO_APPROVE=0

# Comma-separated tool names to disable entirely. Useful for locking down
# capabilities you never want the model to attempt. E.g.:
#   SAMARITAN_DISABLE_TOOLS=speak,open_url,music_control
SAMARITAN_DISABLE_TOOLS=

# Byte cap on the string returned to the model from any single tool call.
# Larger results are truncated with a [output truncated] marker.
SAMARITAN_MAX_TOOL_OUTPUT=8192
